# Copy this file to ".env" (in the repo root) and adjust if needed.
# .env is git-ignored. The server loads it automatically on start.

# Inference runs against your local Ollama server (gemma4:26b). The defaults
# assume the app runs on the SAME box as Ollama (the AI server). Override the
# URL only if the app runs elsewhere on the tailnet.
AITUTOR_OLLAMA_URL=http://127.0.0.1:11434/v1
AITUTOR_MODEL=gemma4:26b

# Where sessions (SQLite + uploaded page images) are stored. The systemd
# service sets this to a stable path; defaults to ~/.local/share/AIEssayTutor.
# AITUTOR_DATA_DIR=/var/lib/aitutor
