# Copy this file to ".env" (in the repo root) and fill in the keys you use.
# .env is git-ignored. The server loads it automatically on start.

# Which online provider to use: gemini | dashscope
AITUTOR_PROVIDER=gemini

# --- Gemini (Google) ---  https://aistudio.google.com/apikey
GEMINI_API_KEY=
AITUTOR_GEMINI_MODEL=gemini-3.5-flash

# --- Alibaba Cloud / Qwen (Model Studio, Singapore region) ---
# https://www.alibabacloud.com/help/en/model-studio/
DASHSCOPE_API_KEY=
AITUTOR_DASHSCOPE_MODEL=qwen3.5-flash
