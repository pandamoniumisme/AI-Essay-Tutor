# Copy this file to ".env" (in the repo root) and fill in your key.
# .env is git-ignored. The server loads it automatically on start.

# Required. Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional model overrides (defaults shown).
AITUTOR_TRANSCRIBE_MODEL=gemini-3.5-flash
AITUTOR_GRADE_MODEL=gemini-3.5-flash
