# Copy this file to ".env" (in the repo root) and fill in your token.
# .env is git-ignored. The server loads it automatically on start.

# Online inference via Hugging Face Inference Providers (OpenAI-compatible
# router), default model Qwen3.5-9B. Token: https://huggingface.co/settings/tokens
HF_TOKEN=

# Optional model override. Append :cheapest or a :provider suffix to route,
# e.g. Qwen/Qwen3.5-9B:cheapest
AITUTOR_HF_MODEL=Qwen/Qwen3.5-9B
